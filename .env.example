# --- Discord OAuth2 (from Discord Developer Portal > OAuth2 > General) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# --- Discord Bot (from Discord Developer Portal > Bot) ---
DISCORD_BOT_TOKEN=

# --- Your Discord server ---
DISCORD_GUILD_ID=

# --- Role IDs allowed to VIEW the dashboard (comma separated) ---
# Right-click a role in Discord (Developer Mode on) > Copy Role ID
ALLOWED_ROLE_IDS=

# --- Role IDs allowed to change thresholds (comma separated). Leave blank to allow any logged-in viewer. ---
ADMIN_ROLE_IDS=

# --- Role IDs that get PINGED on Paper/Oil alerts (comma separated) ---
FM_ROLE_ID=
VP_ROLE_ID=
PRESIDENT_ROLE_ID=

# --- Channel where alerts get posted ---
ALERT_CHANNEL_ID=

# --- WarEra country to track ---
WARERA_COUNTRY_NAME=India

# --- WarEra auth headers (required for treasury coins + resource inventory) ---
# The game authenticates via x-vid and x-gr headers — there are NO login cookies.
# These values are stored as regular browser cookies at app.warera.io.
#
# How to get them:
#   1. Log into https://app.warera.io in Chrome/Edge
#   2. Press F12  ->  Application tab  ->  Cookies  ->  https://app.warera.io
#   3. Find the row named  "vid"  ->  copy its Value column  ->  paste below
#   4. Find the row named  "gr"   ->  copy its Value column  ->  paste below
#   5. Restart the server
#
WARERA_X_VID=
WARERA_X_GR=

# --- Session secret (any random long string) ---
SESSION_SECRET=change_this_to_a_long_random_string

# --- Server port ---
PORT=3000
